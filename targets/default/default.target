<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
   Target platform for EDT_MCP.

   Based on the upstream 1C-Company/dt-example-plugins target for 1C:EDT 2026.1
   (Eclipse Platform 4.30 / 2023-12, Java 17) with additions for the Java MCP SDK
   and its transitives. See docs/superpowers/notes/2026-05-12-spike-mcp-sdk.md
   for the version rationale.

   Servlet stack note (Task 3 Step 0 resolution): 1C:EDT 2026.1 ships javax.servlet 3.1
   and jakarta.servlet-api 4.0 (an alias for javax 4.0, not Jakarta EE 9+/6.x).
   Therefore we DO NOT depend on org.eclipse.equinox.http.jetty here — the MCP HTTP
   transport is hosted by an embedded Jetty 12 EE10 packaged as bundled libs inside
   ru.fedukhin.edt.mcp.core (Task 16 Step 2). Jakarta Servlet 6.1.0 is also bundled
   inside core, not surfaced in the target.
-->
<?pde version="3.8"?><target name="EDT_MCP Default" sequenceNumber="1">
<locations>

<!-- 1C:EDT 2026.1 + Eclipse 2023-12 — local p2 pool (used by the installed IDE).
     Directory location: Tycho indexes every JAR in the directory, no provisioning step, no version conflicts.
     Pool contents: dt.core 27.0.0, dt.platform 12.2.0, wiring 2.5.0, xtext.ui 2.33, e4.* 2.4, ui.* 3.131, jakarta.servlet-api 4.0, com.google.inject 7.0, plus full Eclipse 2023-12 platform & PDE. -->
<location path="C:/Users/yarli/.p2/pool/plugins" type="Directory"/>

<!-- License feature (matches upstream template) -->
<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
<repository location="http://download.eclipse.org/cbi/updates/license/2.0.2.v20181016-2210"/>
<unit id="org.eclipse.license.feature.group" version="0.0.0"/>
</location>

<!-- Test libs (Mockito, ByteBuddy, Objenesis, Commons Codec) — same Orbit drop as dt-example-plugins -->
<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
<repository location="https://download.eclipse.org/tools/orbit/downloads/drops/R20211213173813/repository/"/>
<unit id="org.mockito" version="0.0.0"/>
<unit id="org.objenesis" version="0.0.0"/>
<unit id="net.bytebuddy.byte-buddy" version="0.0.0"/>
<unit id="net.bytebuddy.byte-buddy-agent" version="0.0.0"/>
<unit id="org.apache.commons.codec" version="1.6.0.v201305230611"/>
<unit id="org.junit" version="0.0.0"/>
<unit id="org.hamcrest.core" version="0.0.0"/>
</location>

<!--
  MCP SDK + transitives that aren't carried by 1C:EDT thirdparty or Orbit at the versions
  we need (Jackson 2.20+, slf4j-api 2.x, Project Reactor 3.7, json-schema-validator,
  jakarta.servlet 6.1). The Jakarta Servlet API is bundled inside core too (it's needed at
  runtime for the SDK's HttpServletSseServerTransportProvider), so we include it here for
  resolve-time visibility; the actual class loading happens via Bundle-ClassPath in core.

  missingManifest="generate" makes Tycho wrap non-OSGi jars (json-schema-validator,
  jakarta.servlet-api may or may not be wrappers depending on version) with a generated
  OSGi manifest. SDK itself is already OSGi-native; Reactor publishes bnd metadata.
-->
<location includeDependencyScopes="compile" includeDependencyDepth="infinite" includeSource="false" missingManifest="generate" type="Maven" label="MCP SDK and transitives">
<dependencies>
<dependency>
<groupId>io.modelcontextprotocol.sdk</groupId>
<artifactId>mcp-core</artifactId>
<version>1.1.2</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>io.modelcontextprotocol.sdk</groupId>
<artifactId>mcp-json-jackson2</artifactId>
<version>1.1.2</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>io.projectreactor</groupId>
<artifactId>reactor-core</artifactId>
<version>3.7.0</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>com.networknt</groupId>
<artifactId>json-schema-validator</artifactId>
<version>2.0.0</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>com.ethlo.time</groupId>
<artifactId>itu</artifactId>
<version>1.14.0</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>com.google.inject</groupId>
<artifactId>guice</artifactId>
<version>7.0.0</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>org.slf4j</groupId>
<artifactId>slf4j-simple</artifactId>
<version>2.0.16</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>jakarta.servlet</groupId>
<artifactId>jakarta.servlet-api</artifactId>
<version>6.1.0</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>org.eclipse.jetty</groupId>
<artifactId>jetty-server</artifactId>
<version>12.0.13</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>org.eclipse.jetty.ee10</groupId>
<artifactId>jetty-ee10-servlet</artifactId>
<version>12.0.13</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>com.fasterxml.jackson.core</groupId>
<artifactId>jackson-core</artifactId>
<version>2.20.1</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>com.fasterxml.jackson.core</groupId>
<artifactId>jackson-databind</artifactId>
<version>2.20.1</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>com.fasterxml.jackson.core</groupId>
<artifactId>jackson-annotations</artifactId>
<version>2.20</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>org.slf4j</groupId>
<artifactId>slf4j-api</artifactId>
<version>2.0.16</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>org.reactivestreams</groupId>
<artifactId>reactive-streams</artifactId>
<version>1.0.4</version>
<type>jar</type>
</dependency>
<dependency>
<groupId>jakarta.servlet</groupId>
<artifactId>jakarta.servlet-api</artifactId>
<version>6.1.0</version>
<type>jar</type>
</dependency>
</dependencies>
</location>

</locations>
</target>
