<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.fedukhin.edt.mcp</groupId>
        <artifactId>ru.fedukhin.edt.mcp.parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ru.fedukhin.edt.mcp.repository</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>eclipse-repository</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-p2-repository-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <!-- Ship only what the feature explicitly lists. The feature lists
                         our 3 bundles + the third-party deps that aren't in 1C:EDT
                         2026.1 (MCP SDK, Jetty 12, Jackson 2.20, Reactor, etc.). We
                         deliberately do NOT pull EDT/Eclipse bundles into the repo —
                         the target IDE already has them at versions that match the
                         user's install pool, and shipping different versions
                         (includeAllDependencies=true would) breaks the IDE. -->
                    <includeAllDependencies>false</includeAllDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
