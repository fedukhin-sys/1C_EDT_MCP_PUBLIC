<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.fedukhin.edt.mcp</groupId>
        <artifactId>ru.fedukhin.edt.mcp.parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ru.fedukhin.edt.mcp.tests</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>eclipse-test-plugin</packaging>

    <!--
        Tests reference ICheckRepository.getDescription(CheckUid), which is
        inherited from the internal ICheckMetadataManager. Demote the JDT
        forbidden-reference error to a warning so CheckCatalogTest compiles.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-compiler-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-err:-forbidden</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
